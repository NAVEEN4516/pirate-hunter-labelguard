# Optional: docker compose up --build works without this file.
# Copy to .env to change configuration. Never commit .env.
LG_PROVIDER_MODE=stub
# Leave blank/remove to use the Compose-injected internal stub address.
# For a real provider set its OpenAI-compatible BASE URL (including /v1 if required),
# model identifier, API key and the two actual per-million-token prices below.
# No external endpoint, credential or real provider model is stored in source.
# LG_PROVIDER_URL=
LG_PROVIDER_MODEL=
LG_PROVIDER_API_KEY=
LG_PROMPT_COST_PER_MILLION=0
LG_COMPLETION_COST_PER_MILLION=0
LG_PROMPT_VERSION=v2
LG_PROVIDER_TIMEOUT_S=8
LG_PROVIDER_RETRIES=2
LG_PROVIDER_FAILURE_THRESHOLD=3
LG_PROVIDER_COOLDOWN_S=20
LG_MAX_STEPS=24
LG_MAX_TOOL_CALLS=12
LG_RUN_TIMEOUT_S=45
LG_TOOL_TIMEOUT_S=5
LG_LEASE_S=90
LG_MAX_JOB_ATTEMPTS=2
LG_RATE_LIMIT_PER_MINUTE=30
LG_CACHE_ENABLED=true
LG_CACHE_TTL_S=3600
LG_QUALITY_SAMPLE_RATE=0.25
LG_STUB_DELAY_S=0.35
# Enable only for the local failure demonstration; stub controls are then exposed.
LG_ENABLE_FAULTS=false
LG_BIND_ADDRESS=127.0.0.1
LG_API_PORT=8000
LG_STUB_PORT=8010

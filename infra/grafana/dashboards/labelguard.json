{
  "uid": "pirate-hunter-labelguard",
  "title": "Pirate Hunter | LabelGuard Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Run latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "labelguard-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(labelguard_run_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}} {{agent}} {{step}} {{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(labelguard_run_seconds_bucket[5m])) by (le))",
          "refId": "B",
          "legendFormat": "{{job}} {{instance}} {{agent}} {{step}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completed throughput by agent",
      "datasource": {
        "type": "prometheus",
        "uid": "labelguard-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(labelguard_runs_total[5m])) by (agent)",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}} {{agent}} {{step}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
